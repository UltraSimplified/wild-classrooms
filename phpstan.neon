includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    # Models declare casts() with an `@return array<string, string>` docblock,
    # which hides the real keys from Larastan. Parse the method body instead.
    parseModelCastsMethod: true

    # The schema now lives in one consolidated migration, so Larastan can read
    # it to infer model attribute types instead of needing @property docblocks.
    databaseMigrationsPath:
        - database/migrations

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes

    # Nova custom tools/cards live in nova-components/ as separate path
    # packages with their own builds, so they're deliberately not analysed here.

    # Raise one level at a time (5 -> 6 -> 7...) once the baseline is clean.
